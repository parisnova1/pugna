# JWT_SECRET is auto-generated into .env on first run (see src/env.js) —
# nothing to set here for it, and setting it yourself (e.g. as a platform
# env var in production) takes precedence over the auto-generated file.

# OAuth client IDs from Google Cloud Console (APIs & Services > Credentials).
# Must match the EXPO_PUBLIC_GOOGLE_CLIENT_ID_* values the mobile app uses —
# these are the same client IDs, just without the EXPO_PUBLIC_ prefix, since
# the server verifies each Google ID token's audience against them. Only set
# the ones you've actually created a Google Cloud client for.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
